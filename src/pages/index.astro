---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CTA from '../components/CTA.astro';
import Faq from '../components/Faq.astro';
import Presenter from '../components/Presenter.astro';
import Testimonials from '../components/Testimonials.astro';
import { FAQ, faqSchema } from '../data/faq';
import { CALENDAR_URL } from '../site';

const faq = FAQ.filter((f) => f.tags.includes('home'));
const title = "Blocages & Intuition | Accompagnement de dirigeantes et femmes cadres clés, Paris";
const description =
  "Accompagnement individuel en entreprise et ateliers pour des femmes qui réussissent mais à qui cela coûte : syndrome de l'imposteur, sur-adaptation, intuition. Psychologie, neurosciences, philosophie et corps. Paris 10e.";
---
<Base title={title} description={description} schema={faqSchema(faq)}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <h1 class="hero-title">Désactiver ce qui freine<br />les <em>femmes dirigeantes.</em></h1>
        <p class="lead">Elles réussissent, mais elles doutent encore beaucoup d'elles-mêmes, se sur-adaptent et se coupent de leur intuition. Cloé Dana, entrepreneure, et Émilien Dereclenne, docteur en philosophie formé en psychologie, ont développé la méthodologie Blocages & Intuition pour qu'elles décident depuis elles-mêmes, et plus depuis la peur.</p>
        <div class="btn-row">
          <a href={CALENDAR_URL} class="btn btn-primary" target="_blank" rel="noopener" data-event="rdv_click" data-location="hero">Réserver mon bilan stratégique</a>
          <a href="/accompagnement/" class="btn btn-outline">L'accompagnement</a>
        </div>
      </div>
      <img src="/images/atelier-blocages-intuition-kaskad.webp" alt="Dirigeantes et cadres lors d'un atelier Blocages & Intuition animé par Cloé Dana à Kaskad République, Paris" width="1600" height="1200" loading="eager" fetchpriority="high" class="hero-photo" />
    </div>
  </section>

  <section class="tight">
    <div class="wrap">
      <div class="grid grid-3 stats">
        <div><p class="num">Psychologie · neurosciences · philosophie · corps</p><p>Quatre entrées, un seul objectif : décider depuis soi.</p></div>
        <div><p class="num">Un regard double</p><p>Une entrepreneure en séance, un philosophe qui écoute chaque séance et prépare la suite avec elle.</p></div>
        <div><p class="num">En présentiel, à Paris</p><p>Dans vos locaux ou à Kaskad République, 10e.</p></div>
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <p class="eyebrow violet">Pour qui</p>
      <h2>Trois raisons <em>d'être ici.</em></h2>
      <div class="grid grid-3" style="margin-top:2.5rem">
        <a class="card white" href="/accompagnement/" style="text-decoration:none">
          <p class="num">Pour vous</p>
          <h3>Un accompagnement individuel</h3>
          <p>Dirigeante, fondatrice, cadre : vous vous reconnaissez et vous voulez travailler cela pour de bon. Financé par votre entreprise, ou par vous.</p>
          <p class="link" style="margin-top:1rem">L'accompagnement individuel →</p>
        </a>
        <a class="card white" href="/ateliers/" style="text-decoration:none">
          <p class="num">Équipes et réseaux</p>
          <h3>Un atelier de deux heures</h3>
          <p>Dix personnes, un thème : la permission, la conformité, le syndrome de l'imposteur, l'intuition.</p>
          <p class="link" style="margin-top:1rem">Les ateliers →</p>
        </a>
        <a class="card white" href="/accompagnement/#entreprise" style="text-decoration:none">
          <p class="num">Pour une personne de votre équipe</p>
          <h3>Une dirigeante clé à accompagner</h3>
          <p>Elle performe, elle sur-adapte, elle doute. Vous voulez protéger un profil rare, dans un cadre sérieux, financé par l'entreprise.</p>
          <p class="link" style="margin-top:1rem">Le parcours entreprise →</p>
        </a>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">Le point de départ</p>
      <h2 style="max-width:22ch">Vos blocages ne viennent pas de faiblesses. Ils viennent <em>de réflexes.</em></h2>
      <p class="lead" style="margin-top:1rem;max-width:640px">Des réflexes appris, intelligents, qui ont longtemps protégé. Ils viennent de deux endroits.</p>
      <div class="points" style="margin-top:2.5rem">
        <div><p class="k">01 · Ce qu'on a appris</p><p>Très tôt, pour être aimée et à sa place. Ne pas déranger. Être irréprochable.</p></div>
        <div><p class="k">02 · Les règles du jeu</p><p>Chaque milieu a les siennes, implicites, rarement écrites pour vous. Tant qu'on ne les voit pas, on les subit.</p></div>
        <div><p class="k">03 · Le travail</p><p>Rendre ces deux choses visibles. Puis changer, concrètement, la façon d'agir. <a href="/methode/" class="link">La méthode</a></p></div>
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <p class="eyebrow violet">Vous vous reconnaissez ?</p>
      <h2 style="max-width:20ch">Les talents les plus stratégiques sont souvent ceux qui se sur-adaptent le plus.</h2>
      <div class="grid grid-3" style="margin-top:2.5rem">
        {[
          "Vous réussissez, mais votre énergie part dans la façade plutôt que dans l'avancée.",
          "Vous savez que vous avez de la valeur. Le doute revient quand même, et ralentit vos décisions.",
          "Vous avez une intuition forte, mais vous ne lui faites plus confiance. Vous sur-rationalisez.",
          "Vous jouez parfaitement le jeu, mais ce n'est pas vraiment vous qui jouez.",
          "Vous sur-adaptez en permanence, et vous sentez que ça coûte quelque chose d'essentiel.",
          "Vous connaissez vos schémas. Mais comprendre ne suffit pas à déplacer.",
        ].map((t, i) => (
          <div class="card white"><p class="num">0{i + 1}</p><p>{t}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">Ce qui change</p>
      <h2>Moins de façade, <em>plus de vous.</em></h2>
      <div class="shift" style="margin-top:2.5rem">
        <div class="less">
          <h3>Moins de</h3>
          <ul>
            <li>doute qui revient malgré les preuves</li>
            <li>décisions retardées, re-vérifiées, déléguées au regard des autres</li>
            <li>énergie dépensée à tenir un rôle</li>
            <li>silence en réunion quand vous aviez la bonne lecture</li>
          </ul>
        </div>
        <div class="more">
          <h3>Plus de</h3>
          <ul>
            <li>décisions prises depuis vous, et plus vite</li>
            <li>confiance dans vos propres signaux, votre intuition comprise</li>
            <li>place prise sans s'excuser, ni se durcir</li>
            <li>énergie au bon endroit : ce qui vous fait avancer, pas ce qui vous protège</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap" style="padding:0 var(--gutter) 5rem">
    <div class="band-grid">
      <img src="/images/lc-prise-de-parole.webp" alt="Cloé Dana en prise de parole, soirée Liberté, Chérie !" width="1800" height="1350" loading="lazy" />
      <img src="/images/cloe-paperboard.webp" alt="Cloé Dana pendant un atelier Blocages & Intuition" width="1350" height="1800" loading="lazy" />
      <img src="/images/kaskad-participantes.webp" alt="Participantes à Kaskad République" width="1800" height="1350" loading="lazy" />
    </div>
  </div>

  <section class="dark">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Un regard double</p>
        <h2>Une entrepreneure en séance. Un philosophe <em>après.</em></h2>
        <p class="lead" style="margin-top:1.25rem">Cloé Dana conduit seule chaque séance, avec dix ans d'entrepreneuriat derrière elle, cofondatrice de Kaskad et de Liberté, Chérie !. Émilien Dereclenne, docteur en philosophie des sciences cognitives, écoute chaque séance enregistrée et prépare la suivante avec elle. Vous ne le verrez pas. Vous repartirez avec sa lecture.</p>
        <div class="btn-row"><a href="/equipe/" class="btn btn-outline">Qui nous sommes</a></div>
      </div>
      <div class="grid grid-2" style="gap:1rem">
        <img src="/images/cloe-dana.webp" alt="Cloé Dana" width="400" height="400" loading="lazy" style="border-radius:6px" />
        <img src="/images/emilien-dereclenne.webp" alt="Émilien Dereclenne" width="400" height="400" loading="lazy" style="border-radius:6px" />
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="eyebrow">Ce qui nous différencie</p>
      <h2>La différence n'est pas de style. Elle est <em>de fond.</em></h2>
      <table class="compare" style="margin-top:2rem">
        <thead><tr><th>Coaching classique</th><th>Blocages & Intuition</th></tr></thead>
        <tbody>
          <tr><td>Travaille sur les comportements visibles</td><td>Travaille sur ce qui génère les comportements</td></tr>
          <tr><td>Part des objectifs et du poste</td><td>Part de la personne et de ce qui lui coûte</td></tr>
          <tr><td>Donne des outils et des techniques</td><td>Désactive ce qui génère le doute chronique</td></tr>
          <tr><td>Aide à mieux performer dans le cadre existant</td><td>Produit un leadership qui ne dépend plus du regard externe</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <p class="eyebrow violet">Les offres</p>
      <h2>Trois façons de travailler <em>avec nous.</em></h2>
      <div class="grid grid-3" style="margin-top:2.5rem">
        <div class="price-card featured">
          <span class="badge">Entreprises</span>
          <h3>Accompagnement individuel</h3>
          <ul class="iconlist">
            <li><Icon name="calendar" class="violet" /><span>Parcours de 6 mois, 2 séances d'1h30 par mois</span></li>
            <li><Icon name="message" class="violet" /><span>2 à 3 exercices, lectures, WhatsApp entre les séances</span></li>
            <li><Icon name="pen" class="violet" /><span>Chaque séance écoutée par Émilien, deux notes écrites</span></li>
            <li><Icon name="handshake" class="violet" /><span>Cadrage et bilan avec l'entreprise</span></li>
          </ul>
          <a href="/accompagnement/#entreprise" class="btn btn-violet">Le parcours et le tarif</a>
        </div>
        <div class="price-card">
          <h3>Atelier en entreprise</h3>
          <ul class="iconlist">
            <li><Icon name="users" class="violet" /><span>2 heures, 10 personnes maximum</span></li>
            <li><Icon name="repeat" class="violet" /><span>Un thème, ou un cycle de trois</span></li>
            <li><Icon name="pin" class="violet" /><span>Chez vous ou à Kaskad République</span></li>
          </ul>
          <a href="/ateliers/" class="btn btn-outline">Les thèmes et le tarif</a>
        </div>
        <div class="price-card">
          <h3>À titre personnel</h3>
          <ul class="iconlist">
            <li><Icon name="user" class="violet" /><span>Le même accompagnement, financé par vous</span></li>
            <li><Icon name="repeat" class="violet" /><span>Mensuel, sans engagement</span></li>
            <li><Icon name="pin" class="violet" /><span>Séances d'1h30 à Paris 10e</span></li>
          </ul>
          <a href="/accompagnement/#personnel" class="btn btn-outline">La formule et le tarif</a>
        </div>
      </div>
      <p class="small muted" style="margin-top:1.5rem">Dans tous les cas, le bilan stratégique de 30 minutes en visio est offert.</p>
    </div>
  </section>

  <section>
    <div class="wrap split">
      <img src="/images/kaskad-republique-salon.webp" alt="Le salon de Kaskad République, Paris 10e, où se tiennent les séances" width="1200" height="1600" loading="lazy" style="border-radius:8px;aspect-ratio:4/5;object-fit:cover" />
      <div>
        <p class="eyebrow">Où, et avec qui déjà</p>
        <h2>À Kaskad République, ou <em>chez vous.</em></h2>
        <p class="lead" style="margin-top:1.25rem">Un lieu de travail et d'accueil cofondé par Cloé, Paris 10e. Toujours en présentiel : c'est là que le corps parle.</p>
        <ul class="iconlist" style="margin-top:1.5rem">
          <li><Icon name="building" class="violet" /><span><strong>En entreprise :</strong> atelier « La permission » pour le réseau Ex Æquo de Covivio, octobre 2026</span></li>
          <li><Icon name="users" class="violet" /><span><strong>En individuel :</strong> six dirigeantes et entrepreneures accompagnées depuis mars 2026</span></li>
        </ul>
      </div>
    </div>
  </section>

  <Testimonials />

  <section class="alt">
    <div class="wrap narrow">
      <p class="eyebrow violet">Questions fréquentes</p>
      <h2 style="margin-bottom:2rem">Ce qu'on nous demande <em>souvent.</em></h2>
      <Faq items={faq} />
      <p style="margin-top:1.5rem"><a href="/faq/" class="link">Toutes les questions</a></p>
    </div>
  </section>

  <CTA location="home-bottom" />
</Base>
